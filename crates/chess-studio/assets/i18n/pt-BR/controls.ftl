## Controles remapeáveis (US-28): mouse, trackpad e teclado.

ctl-open = Controles…
ctl-title = Controles
ctl-intro = Reatribua os atalhos de mouse, trackpad e teclado. Cada perfil local tem os seus. Esc cancela a captura.
ctl-group-pointer = Mouse e trackpad
ctl-group-keyboard = Teclado


ctl-mouse-left = Botão esquerdo
ctl-mouse-middle = Botão do meio
ctl-mouse-right = Botão direito
ctl-mouse-back = Botão voltar
ctl-mouse-forward = Botão avançar
ctl-wheel = Roda
ctl-gesture-two-finger = Dois dedos
ctl-gesture-pinch = Pinça

ctl-none = (sem atalho)
ctl-remove = Remover este atalho
ctl-reassign = Reatribuir
ctl-add = Adicionar
ctl-default = Padrão
ctl-cancel = Cancelar
ctl-waiting = Faça o novo atalho (tecla, botão do mouse, roda ou gesto)…
ctl-reset-all = Restaurar todos os padrões

ctl-conflict = { $trigger } já é de «{ $owner }». Usar em «{ $action }» tira de «{ $owner }».
ctl-conflict-replace = Substituir
ctl-unsupported = Esse tipo de atalho não serve para «{ $action }».
ctl-needs-one = «{ $action }» precisa de pelo menos um atalho.
ctl-replaced = «{ $action }» agora usa o atalho que era de «{ $from }».
