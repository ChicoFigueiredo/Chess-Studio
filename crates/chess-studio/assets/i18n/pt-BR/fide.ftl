fide-infractions = Infrações — Brancas: { $white } | Pretas: { $black }

fide-state-idle = Toque numa peça para jogar (o toque é intencional).
fide-state-touched = Peça tocada: { $squares }. A Obrigação de peça tocada vale: mova-a.
fide-state-held = Peça na mão: { $squares }. Solte-a numa casa.
fide-state-released = Peça solta: { $squares }. Acione o relógio para concluir a vez.
fide-state-promotion = Escolha a peça da promoção.

fide-button-retract = Retratar peça
fide-button-pause = Pausar
