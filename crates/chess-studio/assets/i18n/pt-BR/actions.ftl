# Lista única de Ações (DS-14): rótulo, descrição, abas e grupos do Ribbon e motivos de
# desabilitação. Os ids vêm de `chess_input::actions`.

# Abas do Ribbon (DS-02).
ribbon-tab-file = Arquivo
ribbon-tab-home = Início
ribbon-tab-analysis = Análise
ribbon-tab-library = Biblioteca
ribbon-tab-training = Treino
ribbon-tab-view = Exibir

# Grupos do Ribbon.
ribbon-group-game = Partida
ribbon-group-clock = Relógio
ribbon-group-preferences = Preferências
ribbon-group-engine = Engine
ribbon-group-panels = Painéis
ribbon-group-library = Biblioteca
ribbon-group-training = Treino
ribbon-group-presentation = Apresentação
ribbon-group-camera = Câmera
ribbon-group-window = Janela
ribbon-group-board = Tabuleiro
ribbon-group-windows = Janelas dos Painéis
ribbon-group-interface = Interface

# Ações só de gesto (Mapa de controles).
action-select = Selecionar / arrastar peça
action-select-desc = Toca ou arrasta uma peça para jogar.
action-adjust = Ajustar peça (j'adoube)
action-adjust-desc = Ajusta uma peça na casa sem jogá-la; só nas Políticas competitivas.
action-orbit = Órbita da câmera
action-orbit-desc = Gira a câmera 360° em torno do tabuleiro.
action-pan = Pan da câmera
action-pan-desc = Desloca a câmera sem girar.
action-zoom = Zoom
action-zoom-desc = Aproxima ou afasta a câmera, dentro dos limites.
action-cancel = Cancelar gesto
action-cancel-desc = Cancela o gesto em curso sem gerar Lance.

# Arquivo.
action-new-game = Nova Partida
action-new-game-desc = Abre a configuração de uma nova Partida; a atual segue até você iniciar.
action-open-controls = Controles…
action-open-controls-desc = Reatribui os atalhos de mouse, trackpad e teclado.
action-open-options = Opções…
action-open-options-desc = Abre as preferências persistentes do aplicativo.

# Início.
action-undo = Desfazer
action-undo-desc = Desfaz o último Lance (e a resposta da Engine, se houver).
action-redo = Refazer
action-redo-desc = Refaz o Lance desfeito.
action-resign = Abandonar
action-resign-desc = Abandona a Partida: o lado da vez ou, contra a Engine, o seu lado.
action-offer-draw = Propor empate
action-offer-draw-desc = Propõe empate ao adversário.
action-claim-draw = Reclamar empate
action-claim-draw-desc = Reclama o empate disponível na Posição atual.
action-clock-press = Acionar o relógio
action-clock-press-desc = Aciona o relógio ao fim do seu Lance.
action-pause-clock = Pausar relógio
action-pause-clock-desc = Pausa e retoma o relógio da Partida.

# Análise.
action-toggle-analysis = Análise
action-toggle-analysis-desc = Liga ou desliga a análise da Posição pela Engine.

# Exibir: Apresentação.
action-present-professional = 3D profissional
action-present-professional-desc = Mostra o tabuleiro em 3D, com o visual de transmissão.
action-present-immersive = Mesa imersiva
action-present-immersive-desc = Mostra o tabuleiro sobre uma mesa, como em jogo físico.
action-present-technical = 2D técnico
action-present-technical-desc = Mostra o tabuleiro em 2D, para estudo e conferência.
action-cycle-presentation = Alternar Apresentação
action-cycle-presentation-desc = Passa para a próxima Apresentação.

# Exibir: câmera.
action-view-top = Vista superior
action-view-top-desc = Câmera olhando o tabuleiro de cima.
action-view-oblique = Vista oblíqua
action-view-oblique-desc = Câmera inclinada, vendo o tabuleiro em perspectiva.
action-view-standard = Vista padrão
action-view-standard-desc = Câmera atrás das peças do seu lado.
action-view-inverted = Vista invertida
action-view-inverted-desc = Câmera atrás das peças do adversário.
action-reset-camera = Resetar a câmera
action-reset-camera-desc = Volta a câmera para a Vista padrão.
action-frame-board = Enquadrar
action-frame-board-desc = Reenquadra o tabuleiro inteiro na área visível.

# Exibir: janela e tabuleiro.
action-toggle-fullscreen = Tela cheia
action-toggle-fullscreen-desc = Alterna a janela entre tela cheia e normal.
action-toggle-focus = Modo Foco
action-toggle-focus-desc = Esconde a interface e deixa só o tabuleiro.
action-toggle-hud = HUD
action-toggle-hud-desc = Liga ou desliga todas as marcas do HUD no tabuleiro.
action-toggle-coordinates = Coordenadas
action-toggle-coordinates-desc = Mostra ou oculta as coordenadas a–h e 1–8 nas bordas do tabuleiro.
action-toggle-table-clock = Relógio
action-toggle-table-clock-desc = Mostra ou esconde o relógio 3D sobre a mesa. Escondido, ele sai do enquadramento.
action-toggle-table-captured = Peças tomadas
action-toggle-table-captured-desc = Mostra, ao lado do tabuleiro, as peças que cada jogador capturou, em 3D.
action-toggle-hover-highlight = Realce ao passar o mouse
action-toggle-hover-highlight-desc = Realça a casa sob o cursor.
action-flip-board = Virar tabuleiro
action-flip-board-desc = Vira o tabuleiro para o outro lado: a Vista 3D, o 2D técnico e o Tabuleiro 2D.

# Exibir: Painéis.
action-panel-notation = Notação
action-panel-notation-desc = Mostra ou oculta o Painel Notação.
action-panel-clock = Relógio
action-panel-clock-desc = Mostra ou oculta o Painel Relógio.
action-panel-captured = Peças capturadas
action-panel-captured-desc = Mostra ou oculta o Painel de peças capturadas.
action-panel-study = Anotações
action-panel-study-desc = Mostra ou oculta o Painel Anotações.
action-panel-aids = Auxílios
action-panel-aids-desc = Mostra ou oculta o Painel Auxílios.
action-panel-review = Revisão
action-panel-review-desc = Mostra ou oculta o Painel Revisão.
action-panel-arbitration = Arbitragem
action-panel-arbitration-desc = Mostra ou oculta o Painel Arbitragem.
action-panel-training = Treino
action-panel-training-desc = Mostra ou oculta o Painel Treino.
action-panel-analysis = Painel Análise
action-panel-analysis-desc = Mostra ou oculta o Painel Análise.
action-panel-library = Biblioteca
action-panel-library-desc = Mostra ou oculta o Painel Biblioteca.
action-panel-openings = Aberturas
action-panel-openings-desc = Mostra ou oculta o explorador de aberturas.
action-panel-scoresheet = Súmula
action-panel-scoresheet-desc = Mostra ou oculta o Painel Súmula.
action-panel-board2d = Tabuleiro 2D
action-panel-board2d-desc = Mostra ou oculta o Painel Tabuleiro 2D.
action-panel-engines = Engines
action-panel-engines-desc = Mostra ou oculta o gerenciador de Engines.

# Exibir: janelas dos Painéis e interface.
action-float-panel = Flutuar Painel
action-float-panel-desc = Tira o Painel ativo do dock e o coloca numa janela flutuante.
action-dock-panel = Encaixar Painel
action-dock-panel-desc = Devolve ao dock o último Painel flutuante ou, sem nenhum, a última janela destacada.
action-detach-panel = Destacar Painel
action-detach-panel-desc = Leva o Painel para uma janela própria do sistema, que pode ir para outro monitor.
action-detach-group = Destacar grupo em janela
action-detach-group-desc = Leva o grupo de abas do Painel ativo para uma janela própria do sistema, que pode ir para outro monitor.
action-reset-layout = Restaurar layout
action-reset-layout-desc = Volta os Painéis ao layout de fábrica.
action-open-library = Abrir Biblioteca
action-open-library-desc = Mostra o Painel Biblioteca, onde se importa PGN e se buscam Partidas.
action-open-openings = Abrir Aberturas
action-open-openings-desc = Mostra o Painel Aberturas.
action-export-pgn = Exportar PGN
action-export-pgn-desc = Grava a Partida atual em PGN na pasta Documentos.
action-open-training = Abrir Treino
action-open-training-desc = Mostra o Painel Treino, com os Exercícios.
action-hide-all-panels = Ocultar todos os Painéis
action-hide-all-panels-desc = Esconde todos os Painéis, encaixados e flutuantes. Usada de novo, devolve exatamente os que estavam abertos.
action-ui-zoom-in = Aumentar interface
action-ui-zoom-in-desc = Aumenta a Escala da interface, até 200%.
action-ui-zoom-out = Diminuir interface
action-ui-zoom-out-desc = Diminui a Escala da interface, até 80%.
action-open-palette = Paleta de Ações
action-open-palette-desc = Busca qualquer Ação pelo nome e a executa.
action-toggle-ribbon-collapse = Recolher o Ribbon
action-toggle-ribbon-collapse-desc = Mostra só as abas do Ribbon, liberando espaço para o tabuleiro.

# Motivos de uma Ação estar desabilitada.
reason-assisted-only = Só no modo Assistido.
reason-nothing-to-undo = Não há Lance para desfazer.
reason-nothing-to-redo = Não há Lance para refazer.
reason-no-game-running = Não há Partida em andamento.
reason-no-clock = A Partida não tem relógio.
reason-draw-offer-pending = Já há uma proposta de empate esperando resposta.
reason-no-claimable-draw = Nenhum empate pode ser reclamado nesta Posição.
reason-engine-consent = Autorize uma Engine antes de usar a Análise.
reason-training-lock = Indisponível durante um Exercício de Treino.
reason-competitive-lock = Indisponível numa Partida competitiva em andamento.
reason-no-docked-panel = Não há Painel encaixado para flutuar ou destacar.
reason-no-floating-panel = Não há Painel flutuante para encaixar.
reason-3d-only = A câmera só existe nas Apresentações em 3D.
reason-coming-soon = Ainda não disponível.
reason-pgn-scoresheet = Exportar PGN fica indisponível enquanto a Súmula está aberta.
